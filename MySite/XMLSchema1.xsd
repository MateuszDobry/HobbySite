<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" attributeFormDefault="unqualified" elementFormDefault="qualified">
	
	<xs:element name="strona" type="Strona_type"/>
	<xs:complexType name="Strona_type">
		<xs:sequence>
			<xs:element name="hobbys" type="Hobbys_type"/>
			<xs:element name="informations" type="Informations_type"/>
			<xs:element name="interactions">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="interaction" maxOccurs="unbounded">
							<xs:complexType>
								<xs:sequence>							
									<xs:element ref="name"/>	
							</xs:sequence>
								<xs:attribute ref="mocna"/>
							</xs:complexType>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="formularz" type="Formularz_type"/>
			<xs:element name="Galleria" type="Galeria_type"/>
			<xs:element name="DaneKontaktowe">
				<xs:complexType >
					<xs:sequence>
						<xs:element name="introduction" type="xs:string"/>
						<xs:element name="formularz" type="Formularz_type"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element >
			<xs:element name="zakonczenie" type="zakonczenie_type"/>
		</xs:sequence>
			
	</xs:complexType>

	<xs:complexType name="zakonczenie_type">
		<xs:sequence>
			<xs:element ref="name"/>
		</xs:sequence>
		<xs:attribute ref="data"/>
	</xs:complexType>

	<xs:attribute name="data">
		<xs:simpleType>
			<xs:restriction base="xs:gYear"/>
		</xs:simpleType>
	</xs:attribute>

	<xs:complexType name="Informations_type">
		<xs:sequence>
			<xs:element name="information" type="Information_type" maxOccurs="unbounded"/>
			<xs:element name="extraInformation" type="Extra_informations_type" maxOccurs="unbounded"/>
		</xs:sequence>
		
	</xs:complexType>

		<xs:complexType name="Information_type">
			<xs:sequence>
				<xs:element name="name" type="xs:string"/>
				<xs:element name="description" type="xs:string"/>
			</xs:sequence>
			<xs:attribute name="extra">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="yes"/>
						<xs:enumeration value="no"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>
		</xs:complexType>

	<xs:complexType name="Extra_informations_type">
		<xs:complexContent>
			<xs:extension base="Information_type">
				<xs:sequence>
					<xs:element name="link" type="link_type"/>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	
	<xs:complexType name="link_type">
        <xs:simpleContent>
            <xs:extension base="xs:string">
                <xs:attribute name="source" type="xs:anyURI" use="required"/>
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>
	
	<xs:element name="name" type="xs:string"/>

	<xs:complexType name="Hobbys_type">
		<xs:sequence>
			<xs:element name="hobby" type="Hobby_type" minOccurs="0" maxOccurs="3"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="Hobby_type">
		<xs:sequence>
			<xs:element name="name" type="xs:string"/>
			<xs:element name="description" type="xs:string"/>
			<xs:element name="image">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="title" type="xs:string"/>		
					</xs:sequence>	
				<xs:attribute name="source" type="xs:anyURI"/>
			</xs:complexType>
		</xs:element>
		</xs:sequence>
	</xs:complexType>
	


	<xs:complexType name="Formularz_type">
		<xs:sequence>
			<xs:element name="element" type="Element_type" minOccurs="0" maxOccurs="unbounded"/>
		</xs:sequence>
		<xs:attribute name="długi" type="xs:string"/>
	</xs:complexType>
	<xs:complexType name="Element_type">
		<xs:sequence>
			<xs:element name="name" type="Name_type"/>
		</xs:sequence>
	</xs:complexType>
	
	<xs:simpleType name="Name_type">
		<xs:restriction base="shortStringType">
			<xs:minLength value="3"/>
			<xs:maxLength value="100"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="shortStringType">
        <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:maxLength value="100"/>
        </xs:restriction>
    </xs:simpleType>



	<xs:attribute name="mocna">
		<xs:simpleType>
			<xs:restriction base="yes_no_type">
				<xs:enumeration value="yes"/>
				<xs:enumeration value="no"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:attribute>

	<xs:simpleType name="yes_no_type">
        <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:maxLength value="3"/>
        </xs:restriction>
    </xs:simpleType>

	<xs:complexType name="Galeria_type">
		<xs:sequence>
			<xs:element name="image" type="Galeria_image_type" maxOccurs="6"/>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="Galeria_image_type">
		<xs:attribute name="temat" type="temat_type">
		</xs:attribute>
		<xs:attributeGroup ref="grupa"/>
	</xs:complexType>

	<xs:simpleType name="temat_type">
				<xs:restriction base="Shortstring_type">
					<xs:enumeration value="Taniec"/>
					<xs:enumeration value="Perkusja"/>
					<xs:enumeration value="Gotowanie"/>
				</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="Shortstring_type">
        <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:maxLength value="50"/>
        </xs:restriction>
    </xs:simpleType>

	<xs:attributeGroup name="grupa">
		<xs:attribute name="numer" type="numer_type"/>
		<xs:attribute ref="mocna" use="optional"/>
		<xs:attribute name="source" type="xs:anyURI"/>
	</xs:attributeGroup>

	<xs:simpleType name="numer_type">
	<xs:restriction base="xs:integer">
		<xs:minInclusive value="1"/>
		<xs:maxInclusive value="6"/>
	</xs:restriction>
	</xs:simpleType>

</xs:schema>
